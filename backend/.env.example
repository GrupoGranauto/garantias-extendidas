# ---------- Servidor ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Portales por sucursal: <subdominio>.DOMINIO_BASE
DOMINIO_BASE=autoinsights.mx

# ---------- Supabase (SOLO backend) ----------
# Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: cadena de conexion Postgres. AQUI va la contraseña de la BDD.
# Dashboard > Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ---------- BigQuery ----------
# Ruta al JSON de la cuenta de servicio.
# Relativa a la raiz del proyecto, o absoluta si prefieres sacarla del repo.
GOOGLE_APPLICATION_CREDENTIALS=secrets/bigquery-service-account.json
# En servidores sin disco (Railway) se usa esta en lugar de la ruta:
# el contenido completo del JSON en una sola linea.
GOOGLE_CREDENTIALS_JSON=
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=garantias_extendidas
BIGQUERY_LOCATION=US
